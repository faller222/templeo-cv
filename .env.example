GEMINI_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=templeo-cv.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=templeo-cv
VITE_FIREBASE_STORAGE_BUCKET=templeo-cv.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Exact providerId from Firebase Console > Authentication > OpenID Connect
VITE_FIREBASE_LINKEDIN_PROVIDER_ID=oidc.linkedin
# LinkedIn OIDC — client id es público (default en código: 77sth81lkh6wes)
VITE_LINKEDIN_CLIENT_ID=77sth81lkh6wes
# Solo el secret va a Secret Manager / .env local
LINKEDIN_CLIENT_SECRET=
# Solo bridge local — Cloud Functions lo fuerza a false
ALLOW_UNAUTHENTICATED_AI=true
